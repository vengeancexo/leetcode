class Solution {
public:
    bool isPalindrome(string &s, int l, int r) {
        while(l < r) {
            if(s[l] != s[r])
                return false;
            l++;
            r--;
        }
        return true;
    }
    void helper(int start, string s, vector<vector<string>> &ans, vector<string> &curr){
        if(start == s.size()){
            ans.push_back(curr);
            return;
        }
        for(int ending = start; ending<s.size();ending++){
            if(isPalindrome(s, start, ending)){
                curr.push_back(s.substr(start, ending-start+1));
                helper(ending+1, s, ans, curr);
                curr.pop_back();
            }
        }
    }
    vector<vector<string>> partition(string s) {
        vector<vector<string>> ans;
        vector<string> curr;
        helper(0, s, ans, curr);
        return ans;
    }
};
